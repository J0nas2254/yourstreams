# Kopiere diese Datei nach .env.local und trage echte Schlüssel ein.
# Schlüssel NIEMALS in den Chat oder einen Prompt schreiben - nur hier lokal eintragen.
# Niemals echte Schlüssel committen (.env.local steht in .gitignore).
#
# TMDb: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# OMDb (IMDb-Bewertungen, optional): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Nur für den Capacitor-APK-Build: öffentlich erreichbares HTTPS-Backend
# (diese App selbst gehostet, z. B. https://mein-server.example.com).
# ACHTUNG: Schlüssel können aus einer APK ausgelesen werden -
# APK nicht öffentlich verteilen und Backend-Zugriff ggf. einschränken.
NEXT_PUBLIC_API_BASE=
